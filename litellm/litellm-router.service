[Unit]
Description=LiteLLM local model router for Compute Swarm
After=network-online.target ollama.service
Wants=network-online.target
Requires=ollama.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/litellm-router
EnvironmentFile=/etc/litellm/router.env
ExecStart=/opt/litellm-router/venv/bin/litellm --config /etc/litellm/config.yaml --host 127.0.0.1 --port 4000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
