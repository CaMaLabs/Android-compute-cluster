[Unit]
Description=Compute Swarm trusted HTTPS quick tunnel
After=network-online.target compute-swarm-port-proxy.service
Wants=network-online.target
Requires=compute-swarm-port-proxy.service

[Service]
Type=simple
User=root
Group=root
Environment=SWARM_TUNNEL_TARGET=http://127.0.0.1:8765
Environment=SWARM_TUNNEL_URL_FILE=/var/lib/compute-swarm/cloudflared-url.txt
ExecStart=/usr/bin/python3 /opt/compute-swarm/proxy/cloudflared_quick_tunnel.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
